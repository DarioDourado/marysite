# MAINTENANCE_MODE: set to "true" to serve the maintenance page (HTTP 503) for every route.
MAINTENANCE_MODE="false"

# API (FastAPI) a que o servidor do site reencaminha /api/v1 e /media.
# Em desenvolvimento o Vite usa http://localhost:8000 se estiver vazio; em produção é obrigatório.
API_PROXY_TARGET=

# Só se a API estiver noutro domínio (build do site). Vazio = mesmo domínio.
VITE_API_BASE_URL=
VITE_MEDIA_BASE_URL=
