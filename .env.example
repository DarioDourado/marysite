# MAINTENANCE_MODE: set to "true" to serve the maintenance page (HTTP 503) for every route.
MAINTENANCE_MODE="false"

# API (FastAPI) a que o servidor do site reencaminha /api/v1 e /media.
# Em desenvolvimento o Vite usa http://localhost:8000 se estiver vazio; em produção é obrigatório.
API_PROXY_TARGET=

# Só se a API estiver noutro domínio (build do site). Vazio = mesmo domínio.
VITE_API_BASE_URL=
VITE_MEDIA_BASE_URL=

# SEO (ver docs/seo/final-seo-report.md)
# URL público do site, sem barra final. Obrigatório em produção: usado no canonical, sitemap.xml,
# Open Graph e dados estruturados, e para redirecionar www/http para o endereço canónico.
SITE_URL=
# "true" quando o blog tiver artigos: passa a ficar no sitemap e indexável (até lá fica noindex).
SEO_INDEX_BLOG="false"
# Atrás de um proxy/balanceador (Nginx, Cloudflare...): "true" ou o número de proxies, para o protocolo/host reais.
TRUST_PROXY=
